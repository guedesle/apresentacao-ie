---
import { consultationNav } from '../data/content';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Modernização do Faturamento — início">
      <span class="brand-mark" aria-hidden="true">egba</span>
      <span class="brand-copy"><strong>Diário Oficial</strong><small>Inteligência Editorial</small></span>
    </a>
    <nav class="main-nav" aria-label="Navegação principal">
      {consultationNav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="button button-compact" href="/apresentacao/">Apresentar</a>
  </div>
</header>
